<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:background="@drawable/bg_header_gradiente">

            <TextView
                android:id="@+id/tvVolver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Volver"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Tienda"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tus garritas"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ivGarrita"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_garrita"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvSaldo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    tools:text="120" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvSinAnuncios"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Sin anuncios hasta el 5 de agosto"
                tools:visibility="visible" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingBottom="8dp"
            android:text="Consigue garritas"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnVerAnuncio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            android:padding="16dp"
            android:background="@drawable/bg_tarjeta"
            android:textColor="@color/white"
            android:textSize="14sp"
            tools:text="Ver un anuncio · +10 garritas" />

        <TextView
            android:id="@+id/btnBonusDiario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            android:padding="16dp"
            android:background="@drawable/bg_tarjeta"
            android:textColor="@color/white"
            android:textSize="14sp"
            tools:text="Bonus diario · +5 garritas" />

        <TextView
            android:id="@+id/btnCanjearCodigo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="20dp"
            android:padding="16dp"
            android:background="@drawable/bg_tarjeta"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:text="Canjear código de Patreon" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingBottom="8dp"
            android:text="Canjea tus garritas"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSinAnuncios1Dia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            android:padding="16dp"
            android:background="@drawable/bg_tarjeta"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:text="1 día sin anuncios · 150 garritas" />

        <TextView
            android:id="@+id/btnSinAnuncios1Semana"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            android:padding="16dp"
            android:background="@drawable/bg_tarjeta"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:text="1 semana sin anuncios · 800 garritas" />

        <TextView
            android:id="@+id/btnSinAnuncios1Mes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="24dp"
            android:padding="16dp"
            android:background="@drawable/bg_tarjeta"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:text="1 mes sin anuncios · 2500 garritas" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp"
            android:text="Los códigos se consiguen apoyando el proyecto en Patreon."
            android:textColor="@color/muted"
            android:textSize="11sp" />

    </LinearLayout>

</ScrollView>
