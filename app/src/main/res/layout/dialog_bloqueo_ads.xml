<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panelBloqueoAds"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6000000"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_boton_gradiente"
        android:orientation="vertical"
        android:padding="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1a1524"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#33e63946"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="REQUERIDO"
                android:textColor="#ff8a8a"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Para leer, desactiva el bloqueador"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBloqueoMensaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="2dp"
                android:text="Detectamos un bloqueador de anuncios. Para seguir leyendo, desactívalo o quita los anuncios desde la Tienda."
                android:textColor="#B0A8C0"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnBloqueoTienda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_boton_gradiente"
                android:gravity="center"
                android:padding="14dp"
                android:text="Ir a la Tienda"
                android:textColor="@android:color/white"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnBloqueoDns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#2a2438"
                android:gravity="center"
                android:padding="14dp"
                android:text="Abrir ajustes de DNS"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/btnBloqueoReintentar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:padding="12dp"
                android:text="Ya lo desactivé"
                android:textColor="#9a8fb0" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Pro y sin anuncios no ven este aviso"
                android:textColor="#6a6078"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
