<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvUpdateTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hay una nueva actualización"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/white" />

    <TextView
        android:id="@+id/tvUpdateVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Versión 1.9.9.5"
        android:textSize="14sp"
        android:textColor="#B0B0B0" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxHeight="220dp">

        <TextView
            android:id="@+id/tvUpdateNotas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:textColor="#DDDDDD"
            android:text="Notas de la versión" />
    </ScrollView>

    <ProgressBar
        android:id="@+id/progressUpdate"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:max="100"
        android:progress="0"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvUpdatePorcentaje"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="0%"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="@android:color/white"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnUpdateMasTarde"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Más tarde"
            style="?android:attr/buttonBarButtonStyle" />

        <Button
            android:id="@+id/btnUpdateAhora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Actualizar"
            style="?android:attr/buttonBarButtonStyle" />
    </LinearLayout>
</LinearLayout>
